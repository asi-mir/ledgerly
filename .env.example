# Names only. Copy to .env and fill in. Never commit .env.

# Telegram (create the bot with @BotFather; get your numeric ID from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_IDS=
# Defaults; change in Render if you live elsewhere
CURRENCY=₺
TIMEZONE=Europe/Istanbul

# Gemma: aistudio (default) or ollama
GEMMA_PROVIDER=aistudio
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# TabPFN through the Prior Labs API
TABPFN_TOKEN=

# Local: sqlite. Render fills this from its Postgres.
DATABASE_URL=sqlite:///data/private/ledger.db

# Sentry agent tracing (optional; empty = off)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Demo copy only: pin the bot's date and seed a synthetic household (YYYY-MM-DD)
DEMO_TODAY=
